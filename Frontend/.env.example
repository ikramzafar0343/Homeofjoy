# Public site origin used for canonical URLs and Open Graph.
# Production example: https://homeofjoy.vercel.app  or your custom domain
NEXT_PUBLIC_SITE_URL=

# Optional verified contact form endpoint. Leave empty to prevent fake submissions.
# When empty, the contact form shows an error dialog and does not claim success.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional verified newsletter endpoint. Leave empty to prevent fake subscriptions.
# When empty, subscribe explains that signup is not connected yet.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
